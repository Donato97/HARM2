{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "DB",
    "version": "0.1.0",
    "identifier": "com.db.desktop",
    "build": {
        "frontendDist": "../../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "DB",
                "width": 1200,
                "height": 800,
                "url": "http://axum.localhost/init"
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "publisher": "Donato Bitetto",
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": {
            "../../dist/assets/*": "dist/assets/",
            "../../dist/.vite/*": "dist/.vite/"
        }
    }
}
