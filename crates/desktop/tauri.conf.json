{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HARM2",
  "version": "0.1.0",
  "identifier": "com.harm2.desktop",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HARM2",
        "width": 1200,
        "height": 800,
        "url": "http://axum.localhost/init"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
